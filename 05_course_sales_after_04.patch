+<script>
+// 05: new staff-only course sale screen, independent of the 04 mixed-booking form.
+const courseSale05Tiers = {{ course_tiers|tojson }};
+function courseSale05AddPayment(method='cash',amount='0') {
+  const methods=[['cash','現金'],['credit_card','信用卡'],['bank_transfer','匯款'],['stored_value','儲值扣款'],['other','其他']];
+  const container=document.getElementById('courseSale05Payments');
+  if(container.querySelectorAll('.cp05-line').length>=20) return;
+  const div=document.createElement('div'); div.className='cp05-line d-flex gap-2 mb-2';
+  const select=document.createElement('select'); select.className='form-select cp05-method';
+  for(const [code,label] of methods){const o=new Option(label,code);select.add(o);} select.value=method;
+  const input=document.createElement('input'); input.type='number';input.min='0';input.step='1';
+  input.value=amount;input.className='form-control cp05-amount';
+  const remove=document.createElement('button'); remove.type='button';remove.className='btn btn-outline-danger';remove.textContent='×';
+  remove.onclick=()=>{div.remove();courseSale05Validate();};
+  select.onchange=courseSale05Validate;input.oninput=courseSale05Validate;
+  div.append(select,input,remove);container.append(div);courseSale05Validate();
+}
+function courseSale05DefaultPrice() {
+  const course=document.getElementById('courseSale05Course');const count=document.getElementById('courseSale05Count');
+  const selected=course.selectedOptions[0];
+  if(!selected?.value){count.innerHTML='<option value="">先選擇課程</option>';return;}
+  const tier=courseSale05Tiers[selected.value]||{};
+  const oldCount=count.value;
+  count.innerHTML='';
+  for(const qty of [1,...Object.keys(tier).map(Number).sort((a,b)=>a-b)]){
+    count.add(new Option(`${qty} 堂`,String(qty)));
+  }
+  if(Array.from(count.options).some(o=>o.value===oldCount))count.value=oldCount;
+  courseSale05SetPrice();
+}
+function courseSale05SetPrice() {
+  const course=document.getElementById('courseSale05Course'); const qty=document.getElementById('courseSale05Count').value;
+  const tier=courseSale05Tiers[course.value]||{};
+  const amount=qty==='1'?Number(course.selectedOptions[0]?.dataset.price||0):Number(tier[qty]||0);
+  document.getElementById('courseSale05Price').value=String(Math.round(amount));
+  document.getElementById('courseSale05Default').textContent=amount.toLocaleString();
+  const payments=document.querySelectorAll('#courseSale05Payments .cp05-line');
+  if(payments.length===1) payments[0].querySelector('.cp05-amount').value=String(Math.round(amount));
+  courseSale05Validate();
+}
+function courseSale05Validate() {
+  const customer=document.getElementById('courseSale05Customer');
+  const wallet=Number(customer.selectedOptions[0]?.dataset.balance||0);
+  document.getElementById('courseSale05Wallet').textContent=Math.floor(wallet).toLocaleString();
+  const total=Number(document.getElementById('courseSale05Price').value||0);
+  let paid=0,stored=0;
+  document.querySelectorAll('#courseSale05Payments .cp05-line').forEach(div=>{
+    const amount=Number(div.querySelector('.cp05-amount').value||0);
+    paid+=amount;if(div.querySelector('.cp05-method').value==='stored_value')stored+=amount;
+  });
+  let err='';
+  if(!Number.isInteger(total)||total<=0)err='課程售價必須為正整數';
+  else if(!Number.isInteger(paid)||paid!==total)err=`付款合計 NT$${paid}，須付清 NT$${total}`;
+  else if(stored>wallet)err='儲值餘額不足';
+  document.getElementById('courseSale05BalanceError').textContent=err;
+  return !err;
+}
+async function bookOwned05Load() {
+  const customer=document.getElementById('bookOwned05Customer').value;
+  const purchase=document.getElementById('bookOwned05Purchase');
+  purchase.innerHTML='<option value="">讀取中</option>';
+  if(!customer){purchase.innerHTML='<option value="">請先選擇客戶</option>';return;}
+  try{
+    const response=await fetch(`/admin/api/customer/${encodeURIComponent(customer)}/course-purchases`);
+    if(!response.ok)throw new Error('權限或連線問題');
+    const data=await response.json();purchase.innerHTML='';
+    purchase.add(new Option('請選擇課程／購買批次',''));
+    for(const p of data)purchase.add(new Option(`${p.course_name}（批次 #${p.id}，可用 ${p.available} 堂）`,String(p.id)));
+  }catch(e){purchase.innerHTML='<option value="">讀取失敗，請重新整理</option>';}
+}
+document.addEventListener('DOMContentLoaded',()=>{
+  const form=document.getElementById('courseSale05Form');
+  document.getElementById('courseSale05Course')?.addEventListener('change',courseSale05DefaultPrice);
+  document.getElementById('courseSale05Count')?.addEventListener('change',courseSale05SetPrice);
+  document.getElementById('courseSale05Price')?.addEventListener('input',courseSale05Validate);
+  document.getElementById('courseSale05Customer')?.addEventListener('change',courseSale05Validate);
+  const mode=document.getElementById('courseSale05Mode');
+  const setMode=()=>{const show=mode.value!=='save';document.getElementById('courseSale05TimeWrap').hidden=!show;
+    document.getElementById('courseSale05Time').required=show;};
+  mode?.addEventListener('change',setMode);setMode();
+  courseSale05AddPayment();
+  form?.addEventListener('submit',e=>{
+    if(!courseSale05Validate()){e.preventDefault();return;}
+    document.getElementById('courseSale05PaymentsJson').value=JSON.stringify(Array.from(
+      document.querySelectorAll('#courseSale05Payments .cp05-line')).map(div=>({
+      method:div.querySelector('.cp05-method').value,amount:div.querySelector('.cp05-amount').value||'0'
+    })));
+    if(!document.getElementById('courseSale05PaymentsJson').value){e.preventDefault();return;}
+    const button=form.querySelector('button[type="submit"]');if(button)button.disabled=true;
+  });
+  document.getElementById('bookOwned05Customer')?.addEventListener('change',bookOwned05Load);
+});
+</script>
