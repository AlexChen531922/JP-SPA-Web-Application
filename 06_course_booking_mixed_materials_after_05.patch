+<script>
+// 06: shared searchable client picker. The underlying select is the submitted ID.
+function setupSearchableCustomer06(wrapper) {
+  const select=document.getElementById(wrapper.dataset.selectId);
+  const input=wrapper.querySelector('.search-customer06-input');
+  const results=wrapper.querySelector('.search-customer06-results');
+  if(!select||!input||!results) return;
+  const choices=Array.from(select.options).filter(o=>o.value).map(o=>({
+    id:o.value,label:o.textContent.trim(),search:(o.textContent+' '+(o.dataset.search||'')).toLowerCase()
+  }));
+  const render=()=>{
+    const q=input.value.trim().toLowerCase();
+    results.replaceChildren();
+    if(!q){results.style.display='none';return;}
+    for(const entry of choices.filter(o=>o.search.includes(q)).slice(0,25)){
+      const item=document.createElement('button');
+      item.type='button';item.className='list-group-item list-group-item-action text-start';
+      item.textContent=entry.label;
+      item.addEventListener('mousedown',e=>e.preventDefault());
+      item.addEventListener('click',()=>{
+        select.value=entry.id; input.value=entry.label;results.style.display='none';
+        select.dispatchEvent(new Event('change',{bubbles:true}));
+      });
+      results.append(item);
+    }
+    if(!results.children.length){const hint=document.createElement('div');hint.className='list-group-item text-muted';hint.textContent='找不到符合的客戶';results.append(hint);}
+    results.style.display='block';
+  };
+  input.addEventListener('input',()=>{select.value='';select.dispatchEvent(new Event('change',{bubbles:true}));render();});
+  input.addEventListener('focus',render);
+  input.addEventListener('blur',()=>{setTimeout(()=>{results.style.display='none';},180);});
+}
+
+// 06: one-session retail components are a value breakdown, NOT payment methods.
+let sale06ManualPrice=false;
+function sale06RefreshPrice(){
+  const saleCourse=document.getElementById('courseSale05Course');
+  const selected=saleCourse?.selectedOptions[0];
+  const one=document.getElementById('courseSale05Count')?.value==='1';
+  const wrap=document.getElementById('courseSale06Components');
+  const mode=document.getElementById('courseSale06MaterialMode');
+  if(!wrap||!mode) return;
+  wrap.hidden=!one || !selected?.value;
+  const storeOnly=selected?.dataset.storeOnly==='1';
+  for(const o of mode.options) if(o.value!=='store') o.disabled=storeOnly;
+  if(storeOnly) mode.value='store';
+  if(!one || !selected?.value) return;
+  const total=Math.max(0,Math.round(Number(selected.dataset.price)||0));
+  const hand=Math.min(total,Math.max(0,Math.round(Number(selected.dataset.service)||0)));
+  const product=total-hand;
+  let store=product,customer=0;
+  if(mode.value==='customer'){store=0;customer=product;}
+  if(mode.value==='mixed'){store=Math.round(product/2);customer=product-store;}
+  document.getElementById('courseSale06Hand').value=String(hand);
+  document.getElementById('courseSale06Store').value=String(store);
+  document.getElementById('courseSale06CustomerValue').value=String(customer);
+  document.getElementById('courseSale06Store').disabled=mode.value==='customer';
+  document.getElementById('courseSale06CustomerValue').disabled=mode.value==='store';
+  sale06ManualPrice=false;
+  sale06PriceFromComponents();
+}
+function sale06PriceFromComponents(){
+  const total=(Number(document.getElementById('courseSale06Hand').value)||0)+
+              (Number(document.getElementById('courseSale06Store').value)||0);
+  if(!sale06ManualPrice && !document.getElementById('courseSale06Components').hidden){
+    document.getElementById('courseSale05Price').value=String(total);
+    const paymentLines=document.querySelectorAll('#courseSale05Payments .cp05-line');
+    if(paymentLines.length===1) paymentLines[0].querySelector('.cp05-amount').value=String(total);
+  }
+  const actual=Number(document.getElementById('courseSale05Price').value)||0;
+  document.getElementById('courseSale06ComponentHint').textContent=
+    `手技費＋店內產品收費 = NT$ ${total.toLocaleString()}；最終售價差額 NT$ ${(actual-total).toLocaleString()}（調整價，不含寄店已購價值）。`;
+  courseSale05Validate();
+}
+function sale06ValidateComponents(){
+  if(document.getElementById('courseSale06Components').hidden)return true;
+  const mode=document.getElementById('courseSale06MaterialMode').value;
+  const hand=Number(document.getElementById('courseSale06Hand').value);
+  const store=Number(document.getElementById('courseSale06Store').value);
+  const owner=Number(document.getElementById('courseSale06CustomerValue').value);
+  const values=[hand,store,owner];
+  let error='';
+  if(values.some(v=>!Number.isInteger(v)||v<0||v>99999999))error='手技／產品金額必須是非負整數元';
+  else if(mode==='store'&&owner>0)error='店內耗材模式不可輸入客戶寄店價值';
+  else if(mode==='customer'&&store>0)error='客戶寄店模式不可輸入店內產品收費';
+  if(error){document.getElementById('courseSale06ComponentHint').textContent=error;return false;}
+  return true;
+}
